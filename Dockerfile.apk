FROM eclipse-temurin:17-jdk

# Install Node.js, unzip, curl
RUN apt-get update && \
    apt-get install -y nodejs npm unzip curl && \
    rm -rf /var/lib/apt/lists/*

# Install Android SDK
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools"

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    cd /tmp && \
    curl -sO https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q commandlinetools-linux-11076708_latest.zip && \
    mv cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm commandlinetools-linux-11076708_latest.zip

RUN yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"

WORKDIR /app

# Copy only what's needed for build
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build Next.js
RUN npm run build

# Sync Capacitor
RUN npx cap sync android

# Build APK
WORKDIR /app/android
RUN chmod +x gradlew
RUN ./gradlew assembleDebug

# Output APK
CMD ["cp", "/app/android/app/build/outputs/apk/debug/app-debug.apk", "/output/"]
